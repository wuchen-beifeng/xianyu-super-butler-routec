# 闲鱼超级管家 —— 环境变量示例
# 用法：cp .env.example .env && chmod 600 .env，然后按注释替换所有 <...> 占位符。
# 注意：ADMIN_PASSWORD 只在【首次创建数据库】时生效；
#       库已存在后再改这里不会改密码，请在面板「设置 → 账号与同步 → 修改登录密码」改。

# ── 面板登录 ────────────────────────────────────────────────────────────────
ADMIN_USERNAME=<ADMIN_USERNAME>
ADMIN_PASSWORD=<ADMIN_PASSWORD>

# ── 服务 ────────────────────────────────────────────────────────────────────
WEB_PORT=8080
TZ=Asia/Shanghai
LOG_LEVEL=INFO
SQL_LOG_ENABLED=true

# ── 功能开关 ────────────────────────────────────────────────────────────────
AUTO_REPLY_ENABLED=true
AUTO_DELIVERY_ENABLED=true
AI_REPLY_ENABLED=false

# 安全：关掉公开注册入口，避免面板暴露后被人注册账号
USER_REGISTRATION_ENABLED=false
# 未配置 SMTP 时关掉邮箱验证，否则注册/邮件码链路必然失败
EMAIL_VERIFICATION_ENABLED=false
# 保留登录滑块验证
CAPTCHA_ENABLED=true

# ── 资源上限 ────────────────────────────────────────────────────────────────
# 上游文档明确 2G 会被 Chromium 冷启动 OOM 杀掉，故默认给 3G
MEMORY_LIMIT=3072M
MEMORY_RESERVATION=512M
CPU_LIMIT=4.0
CPU_RESERVATION=0.5

# ── 路线 C（滑块）────────────────────────────────────────────────────────────
# 容器内 routec-solver 的访问令牌。生成方式：openssl rand -hex 24
# 必须与 custom/slider_routec/token 文件内容一致（构建时随镜像带入）。
SLIDER_ROUTE_C_TOKEN=<SLIDER_ROUTE_C_TOKEN>

# 可选：覆盖 custom/global_config.example.yml 的 SLIDER_ROUTE_C 段
# SLIDER_ROUTE_C_ENABLED=true
# SLIDER_ROUTE_C_MAX_ATTEMPTS=5
# SLIDER_ROUTE_C_ENDPOINT=http://127.0.0.1:8799
